# --- Docker ---
docker-compose.override.yml

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Database ---
*.sql.bak
pgdata/

# --- Misc ---
*.log
tmp/
temp/
